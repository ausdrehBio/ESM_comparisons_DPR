// Defaults for main.nf. run_server.sh fills in the paths; the rest can be overridden on its
// command line, e.g. `bash run_server.sh --precision bf16 --outdir results_bf16`.
params {
    input          = null    // sequences.fasta from the reference build
    manifest       = null    // manifest.tsv from the reference build
    shards         = null    // directory of shard_*.fasta from the reference build: one EMBED task each
    residue_sample = null    // residue_sample.tsv: residues whose per-residue embeddings are kept
    core_prefix    = null    // env prefixes, set by run_server.sh
    esm2_prefix    = null
    esmc_prefix    = null
    outdir         = 'results'
    device         = 'cuda'  // cuda | cpu
    precision      = 'fp32'  // fp32 | bf16
    max_tokens     = 8192    // padded tokens per batch; lower it if the GPU runs out of memory
    perms          = 9999    // permutations for the null distributions on the sequence sample
    pair_sample    = 2000    // sequences used for all-vs-all metrics (RSA, Gram-based CKA)
}

process.errorStrategy = 'terminate'

// overwrite = true: without it a re-run fails because these files already exist.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    fields    = 'task_id,name,status,exit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
